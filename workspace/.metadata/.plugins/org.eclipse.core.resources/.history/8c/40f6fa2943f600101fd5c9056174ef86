package uifx;

import java.util.Collection;

import javafx.collections.FXCollections;
import javafx.scene.control.ListCell;
import javafx.scene.control.ListView;
import javafx.scene.control.Tab;
import javafx.scene.control.TabPane;
import javafx.util.Callback;
import model.SearchDTO;
import uifx.cells.MatchCell;

public class ResultsScreen extends TabPane {
	
	private Main main;
	
	public ResultsScreen(Main main, SearchDTO dto) {
		super();
		this.main = main;
		getTabs().addAll(
	            createTab(
	                "Matches", 
	                "tab-match", 
	                dto.getMatches(),
	                list -> new MatchCell()
	            ),
	            createTab(
	                "Errors",  
	                "tab-error", 
	                dto.getErrors(),
	                null
	            ),
	            createTab(
	                "Left out", 
	                "tab-left-out", 
	                dto.getLeftOut(),
	                null
	            )
	        );
	}
	
	
	private <T> Tab createTab(String title, String styleClass, Collection<T> items, Callback<ListView<T>, ListCell<T>> e) {
		Tab tab = new Tab(String.format("%s (%d)", title, items.size()));
		tab.setClosable(false);
		tab.getStyleClass().add(styleClass);
		
		ListView<T> view = new ListView<T>(FXCollections.observableArrayList(items));
		if(e != null) view.setCellFactory(e);
		tab.setContent(view);
		return tab;
	}
}
