package service;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.io.Serializable;
import java.nio.file.Path;
import java.nio.file.Paths;

import model.FileFetcher;
import model.SearchDTO;
import model.SortingMode;
import model.ValidationException;
import service.interf.UpdateReflect;
import ui.util.PromptUtil;

public class SorterManager implements Serializable{

	private static final long serialVersionUID = 2L;
	
	private final static String SERIALIZED_FILE = "manager.config";
	
	private String sourceFolder;
	private String targetFolder;
	private SortingMode mode;
	private boolean recursive;
	
	private SorterManager() {
		this.mode = SortingMode.YYYYMMDD;
	}
	
	public final static SorterManager fetchManager() {
		try {
			ObjectInputStream in = new ObjectInputStream(new FileInputStream(SERIALIZED_FILE));
			SorterManager manager = (SorterManager) in.readObject();
			in.close();
			return manager;
		} catch(IOException | ClassNotFoundException e) {
			return new SorterManager();
		}
	}
	
	
	public String getSourceFolder() {
		return sourceFolder;
	}
	
	public String getTargetFolder() {
		return targetFolder;
	}
	
	public SortingMode getSortingMode() {
		return this.mode;
	}
	
	public boolean isRecursive() {
		return this.recursive;
	}
	
	public void setSourceFolder(String sourceFolder) {
		this.sourceFolder = sourceFolder;
	}

	public void setTargetFolder(String targetFolder) {
		this.targetFolder = targetFolder;
	}

	public void setConfigMode(SortingMode mode) {
		this.mode = mode;
	}
	
	public void setRecursive(boolean recursive) {
		this.recursive = recursive;
	}

	public void saveConfig() throws IOException {
		ObjectOutputStream out = new ObjectOutputStream(new FileOutputStream(SERIALIZED_FILE));
		out.writeObject(this);
		out.close();		
	}
	
	public SearchDTO proceed(UpdateReflect updater) {
		validate();
		SearchDTO dto = FileFetcher.fetchMatches(sourceFolder,
				targetFolder, this.mode.getRegExString(), this.recursive, updater);
		return dto;
	}
	
	private void validate() {
		File validatorSource = new File(this.sourceFolder);
		if (!validatorSource.exists())
			throw new ValidationException("Source folder does not exist");
		if(!validatorSource.isDirectory())
			throw new ValidationException("Invalid source folder, path points to a file");
		
		File validatorTarget = new File(this.targetFolder);
		if (!validatorTarget.exists())
			throw new ValidationException("Target folder does not exist, create it first");
		if(!validatorTarget.isDirectory())
			throw new ValidationException("Invalid target folder, path points to a file");
		
		if(this.recursive && targetInsideSource())
			throw new ValidationException("Recursive sorting does not allow for the target folder to be contained in the source folder");
	}
	
	private boolean targetInsideSource() {
		Path parent = Paths.get(this.sourceFolder);
		Path child = Paths.get(this.targetFolder);
		return child.toAbsolutePath().normalize().startsWith(parent.toAbsolutePath().normalize());
	}
	
	
	
}
