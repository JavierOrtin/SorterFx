package uifx;

import java.io.File;

import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.control.Button;
import javafx.scene.control.TextField;
import javafx.scene.layout.BorderPane;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Priority;
import javafx.scene.layout.Region;
import javafx.scene.layout.VBox;
import javafx.stage.DirectoryChooser;
import javafx.stage.Stage;


public class FolderScreen extends BorderPane {
	
	private Stage mainStage;
	private Main main;

    public FolderScreen(Main main, Stage mainStage) {
    	this.main = main;
    	this.mainStage = mainStage;
	
	    VBox centerBox = new VBox(15);
	    centerBox.setPadding(new Insets(20));
	    centerBox.setAlignment(Pos.CENTER);
	    
	    String sourceFolder = this.main.getManager().getSourceFolder();	    
	    HBox row1 = createPathRow(sourceFolder, "Select source folder...");
	    HBox row2 = createPathRow("Select destination folder...");
	    
	    Region spacer = new Region();
	    
	    Button proceedButton = new Button("Proceed");
	    BorderPane.setMargin(proceedButton, new Insets(10, 0, 20, 0));
	    BorderPane.setAlignment(proceedButton, Pos.CENTER);
	    
	    centerBox.getChildren().addAll(row1, row2,spacer, proceedButton);
	    
	    setCenter(centerBox);	
	    getStyleClass().add("path-selector-panel");
	}
	
	private HBox createPathRow(String initialText, String suggestion) {
	
	    TextField pathField = new TextField();
	    pathField.setText(initialText);
	    pathField.setPromptText(suggestion);
	    pathField.setEditable(true);
	
	    Button selectButton = new Button("Select folder");
	    
	    SelectFolderButtonClickFX handler =
	            new SelectFolderButtonClickFX(pathField, suggestion);

	    selectButton.setOnAction(e -> handler.handle());
	
        HBox row = new HBox(10);
        row.setAlignment(Pos.CENTER);

        /* Agranda el campo de texto en lugar del botón */
        HBox.setHgrow(pathField, Priority.ALWAYS);

        row.getChildren().addAll(pathField, selectButton);
        return row;
	}
	
	private class SelectFolderButtonClickFX {

	    private final TextField textField;
	    private final String suggestion;

	    public SelectFolderButtonClickFX(TextField textField, String suggestion) {
	        this.textField = textField;
	        this.suggestion = suggestion;
	    }

	    public void handle() {

	        DirectoryChooser chooser = new DirectoryChooser();
	        chooser.setTitle(suggestion);

	        File current = new File(textField.getText());

	        chooser.setInitialDirectory(
	                (current.exists() && current.isDirectory()) ?
	                        current : recursiveParent(current)
	        );

	        File selected = chooser.showDialog(mainStage);

	        if (selected != null) {
	            textField.setText(selected.getAbsolutePath());
	        }
	    }

	    private File recursiveParent(File file) {
	        try {
	            File parent = file.getParentFile();
	            if (parent == null) return null;
	            if (parent.exists()) return parent;
	            return recursiveParent(parent);
	        } catch (NullPointerException e) {
	            return null;
	        }
	    }
	}
}

    
